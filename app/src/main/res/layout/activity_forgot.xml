<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="match_parent"><TextView android:text="Khôi phục mật khẩu" android:textSize="24sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/username" android:hint="Tên đăng nhập" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/send" android:text="Gửi hướng dẫn qua email" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/token" android:hint="Mã khôi phục trong email" android:layout_width="match_parent" android:layout_height="wrap_content"/><EditText android:id="@+id/password" android:hint="Mật khẩu mới (>=12 ký tự)" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content"/><Button android:id="@+id/reset" android:text="Đặt mật khẩu mới" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp"/></LinearLayout>
